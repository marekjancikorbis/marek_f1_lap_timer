rules_version = '2';

// Purple Sector security rules. These replace the plan's Postgres RLS:
// the app UI hides what you can't do, these rules refuse it.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ helpers

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function roleOf(u) {
      return exists(/databases/$(database)/documents/roles/$(u))
        ? get(/databases/$(database)/documents/roles/$(u)).data.role
        : 'driver';
    }

    // The owner is an admin who also decides admin requests. Set in the console only.
    function isOwner() {
      return signedIn() && roleOf(uid()) == 'owner';
    }

    function isAdmin() {
      return signedIn() && roleOf(uid()) in ['admin', 'owner'];
    }

    // Creators, admins and the owner may build routes.
    function canCreate() {
      return signedIn() && roleOf(uid()) in ['creator', 'admin', 'owner'];
    }

    // Public routes allowed at once: creator 1, admin 5, owner unlimited.
    function publicLimit() {
      let r = roleOf(uid());
      return r == 'owner' ? 1000 : r == 'admin' ? 5 : r == 'creator' ? 1 : 0;
    }

    // Admin and owner routes are shown as Official instead of a username.
    function officialOk(data) {
      return data.get('official', false) == false || roleOf(uid()) in ['admin', 'owner'];
    }

    // Names copied onto routes, posts and requests must be the writer's own
    // username (usernames never change), or anyone could post as anyone.
    function myName() {
      return get(/databases/$(database)/documents/users/$(uid())).data.username;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanges(keys) {
      return changedKeys().hasOnly(keys);
    }

    // ------------------------------------------------------------ profiles

    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn() && userId == uid()
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'createdAt', 'publicRouteIds', 'countdownS', 'acceptedTermsAt', 'avatarHue'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_.]{3,20}$')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.publicRouteIds == []
        // Username claimed in the same batch.
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid();

      allow update: if signedIn() && userId == uid()
        && onlyChanges(['countdownS', 'acceptedTermsAt', 'avatarHue', 'publicRouteIds', 'homeRouteId'])
        && publicRoutesOk()
        && homeRouteOk();

      // Home course: none, or a route anyone can see (public and not hidden).
      function homeRouteOk() {
        let home = request.resource.data.get('homeRouteId', null);
        return home == resource.data.get('homeRouteId', null) || home == null || (
          home is string
          && exists(/databases/$(database)/documents/routes/$(home))
          && get(/databases/$(database)/documents/routes/$(home)).data.isPublic == true
          && get(/databases/$(database)/documents/routes/$(home)).data.hidden == false);
      }

      // publicRouteIds lists the user's public routes. One route in and/or one
      // out per write: an added route must be yours and public after the write,
      // a removed one private, and the list stays within the role's limit
      // (shrinking is always allowed, e.g. after losing a role).
      function publicRoutesOk() {
        let before = resource.data.get('publicRouteIds', []);
        let after = request.resource.data.get('publicRouteIds', []);
        let added = after.removeAll(before);
        let removed = before.removeAll(after);
        // Untouched list: other profile edits must not depend on it (it can be over a lost role's limit).
        return before == after || after is list
          && added.size() <= 1 && removed.size() <= 1
          && (after.size() <= publicLimit() || after.size() < before.size())
          && (added.size() == 0 || (
            getAfter(/databases/$(database)/documents/routes/$(added[0])).data.ownerId == uid()
            && getAfter(/databases/$(database)/documents/routes/$(added[0])).data.isPublic == true))
          && (removed.size() == 0
            || !existsAfter(/databases/$(database)/documents/routes/$(removed[0]))
            || getAfter(/databases/$(database)/documents/routes/$(removed[0])).data.isPublic == false);
      }

      // Runs are private to their owner. Others only ever see posts.
      match /runs/{runId} {
        allow read, delete: if signedIn() && userId == uid();
        allow create: if signedIn() && userId == uid()
          && request.resource.data.totalMs is int && request.resource.data.totalMs > 0
          && request.resource.data.splitTimesMs is list
          && request.resource.data.splitTimesMs.size() > 0
          && request.resource.data.splitTimesMs[request.resource.data.splitTimesMs.size() - 1] == request.resource.data.totalMs;
        // Results are immutable; only the posted marker changes.
        allow update: if signedIn() && userId == uid() && onlyChanges(['posted']);
      }
    }

    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == uid()
        && name == getAfter(/databases/$(database)/documents/users/$(uid())).data.usernameLower;
    }

    // ------------------------------------------------------------ roles

    // Admins hand out creator to users without a role and take it back. Only
    // the owner makes or removes admins. Nobody changes their own role, and the
    // owner role itself is set in the database console, never from the app.
    match /roles/{userId} {
      // Readable by everyone signed in, for badges.
      allow read: if signedIn();
      allow create: if userId != uid() && grantLogged() && (
        (isAdmin() && request.resource.data.role == 'creator')
        || (isOwner() && request.resource.data.role in ['creator', 'admin']));
      allow update: if userId != uid() && grantLogged() && isOwner()
        && resource.data.role in ['creator', 'admin']
        && request.resource.data.role in ['creator', 'admin'];
      allow delete: if userId != uid() && (
        (isAdmin() && resource.data.role == 'creator')
        || (isOwner() && resource.data.role in ['creator', 'admin']));

      function grantLogged() {
        return request.resource.data.grantedBy == uid()
          && existsAfter(/databases/$(database)/documents/roleAudit/$(request.resource.data.auditId));
      }
    }

    match /roleAudit/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorId == uid()
        && request.resource.data.action in ['grant_creator', 'revoke_creator', 'approve_request', 'reject_request',
          'grant_admin', 'revoke_admin', 'approve_admin_request', 'reject_admin_request'];
    }

    match /creatorRequests/{userId} {
      allow read: if signedIn() && (userId == uid() || isAdmin());
      allow create: if signedIn() && userId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.username == myName()
        && roleOf(uid()) == 'driver'
        && (!('note' in request.resource.data) || request.resource.data.note.size() <= 500);
      // A rejected driver can ask again.
      allow update: if (signedIn() && userId == uid()
          && resource.data.status == 'rejected'
          && request.resource.data.status == 'pending'
          && onlyChanges(['status', 'note', 'createdAt', 'decidedBy', 'decidedAt']))
        || (isAdmin() && request.resource.data.status in ['approved', 'rejected']
          && onlyChanges(['status', 'decidedBy', 'decidedAt']));
    }

    // Creators ask to become admins; only the owner decides.
    match /adminRequests/{userId} {
      allow read: if signedIn() && (userId == uid() || isOwner());
      allow create: if signedIn() && userId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.username == myName()
        && roleOf(uid()) == 'creator'
        && (!('note' in request.resource.data) || request.resource.data.note.size() <= 500);
      allow update: if (signedIn() && userId == uid()
          && roleOf(uid()) == 'creator'
          && resource.data.status == 'rejected'
          && request.resource.data.status == 'pending'
          && onlyChanges(['status', 'note', 'createdAt', 'decidedBy', 'decidedAt']))
        || (isOwner() && request.resource.data.status in ['approved', 'rejected']
          && onlyChanges(['status', 'decidedBy', 'decidedAt']));
    }

    // ------------------------------------------------------------ routes

    match /routes/{routeId} {
      // Fields that change where and how a route is timed.
      function shapeKeys() {
        return ['coords', 'lengthM', 'boundaries', 'sectorLengthM', 'isLoop', 'startType', 'start', 'bbox', 'waypoints', 'shapeVersion'];
      }

      // Every shape change bumps shapeVersion by one, so laps timed on an old shape can't be posted.
      function shapeBumped() {
        return !changedKeys().hasAny(shapeKeys())
          || request.resource.data.get('shapeVersion', 0) == resource.data.get('shapeVersion', 0) + 1;
      }

      function shapeOk(d) {
        return d.sectorLengthM is int
          && d.sectorLengthM >= 50 && d.sectorLengthM <= 1000
          && d.sectorLengthM % 50 == 0
          && d.startType in ['standing', 'rolling']
          && d.boundaries is list && d.boundaries.size() > 0
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60;
      }

      // Admins reach driver and creator routes; the owner reaches all.
      function canModerate() {
        return isAdmin() && (isOwner() || !(roleOf(resource.data.ownerId) in ['admin', 'owner']));
      }

      // Never published: only the route's owner can have laps on it. hasRuns
      // is no help here, as only the owner's own drives set it.
      function neverPublished() {
        return resource.data.isPublic == false && resource.data.get('publishedAt', null) == null;
      }

      allow read: if signedIn() && (
        resource.data.ownerId == uid()
        || (resource.data.isPublic == true && resource.data.hidden == false)
        || isAdmin());

      allow create: if canCreate()
        && request.resource.data.ownerId == uid()
        && request.resource.data.ownerName == myName()
        && officialOk(request.resource.data)
        && request.resource.data.isPublic == false
        && request.resource.data.hidden == false
        && request.resource.data.hasRuns == false
        && shapeOk(request.resource.data);

      // Owner edits. Geometry and sectors freeze once anyone else could have
      // driven the route (it has ever been published).
      allow update: if canCreate() && resource.data.ownerId == uid()
        && request.resource.data.ownerId == uid()
        && request.resource.data.ownerName == resource.data.ownerName
        && request.resource.data.hidden == resource.data.hidden
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && (!changedKeys().hasAny(shapeKeys())
          || (neverPublished() && request.resource.data.isPublic == false && shapeOk(request.resource.data) && shapeBumped()))
        && (request.resource.data.hasRuns == true || resource.data.hasRuns == false)
        // Once published, always marked so: the delete and geometry locks depend on it.
        && (resource.data.get('publishedAt', null) == null
          || request.resource.data.get('publishedAt', null) == resource.data.get('publishedAt', null))
        // Only admins set the label; a creator route an admin made Official stays editable by its creator.
        && (!changedKeys().hasAny(['official']) || roleOf(uid()) in ['admin', 'owner'])
        && (request.resource.data.isPublic == false
          || (routeId in getAfter(/databases/$(database)/documents/users/$(uid())).data.get('publicRouteIds', [])
            // Going public also needs the list within the current limit: a removed
            // admin's profile can still list 5 routes, and those stay private.
            && (resource.data.isPublic == true
              || getAfter(/databases/$(database)/documents/users/$(uid())).data.get('publicRouteIds', []).size() <= publicLimit())));

      // Revoked creators keep their routes; they can still mark runs on them.
      allow update: if signedIn() && resource.data.ownerId == uid()
        && onlyChanges(['hasRuns']) && request.resource.data.hasRuns == true;

      // Moderation: admins unpublish or hide other people's routes, but not
      // another admin's or the owner's; the owner moderates any. Taking away
      // the Official label is part of removing an admin. Admins may also make a
      // published creator route Official; its runs and posts stay as they are.
      allow update: if canModerate() && onlyChanges(['isPublic', 'hidden', 'official'])
        && (request.resource.data.isPublic == false || request.resource.data.isPublic == resource.data.isPublic)
        && (request.resource.data.get('official', false) == false
          || request.resource.data.get('official', false) == resource.data.get('official', false)
          || (resource.data.isPublic == true && request.resource.data.isPublic == true));

      // Moderation edit: name, shape and sectors. The app deletes the route's
      // posted laps when the shape changes.
      allow update: if canModerate() && onlyChanges(shapeKeys().concat(['name'])) && shapeOk(request.resource.data) && shapeBumped();

      allow delete: if signedIn() && resource.data.ownerId == uid() && neverPublished();

      // Moderation delete, same reach as moderation updates above.
      allow delete: if canModerate();
    }

    // ------------------------------------------------------------ posts

    // A post is a lap made public. Copied from the owner's run, so the times
    // must match it exactly; the route must be public.
    match /posts/{runId} {
      allow read: if signedIn() && (
        resource.data.hidden == false || resource.data.userId == uid() || isAdmin());

      allow create: if signedIn() && postMatchesRun();

      function postMatchesRun() {
        let p = request.resource.data;
        let run = get(/databases/$(database)/documents/users/$(uid())/runs/$(runId)).data;
        let route = get(/databases/$(database)/documents/routes/$(p.routeId)).data;
        return p.userId == uid()
          && p.username == myName()
          && p.routeName == route.name
          && run.valid == true
          && run.get('replay', false) == false
          && run.routeId == p.routeId
          && run.get('shapeVersion', 0) == route.get('shapeVersion', 0)
          && p.totalMs == run.totalMs
          && p.splitTimesMs == run.splitTimesMs
          && p.penaltyMs == run.penaltyMs
          && p.jumpStart == run.jumpStart
          && (p.jumpStart == false || p.penaltyMs == 5000)
          && p.splitTimesMs.size() == route.boundaries.size()
          && p.splitTimesMs[p.splitTimesMs.size() - 1] == p.totalMs
          && p.totalMs > 0
          && route.isPublic == true && route.hidden == false
          && p.hidden == false
          && extrasOk(p);
      }

      function extrasOk(p) {
        return (!('caption' in p) || p.caption == null || (p.caption is string && p.caption.size() <= 280))
          && (!('car' in p) || p.car == null || (p.car is string && p.car.size() <= 40));
      }

      allow update: if (signedIn() && resource.data.userId == uid() && onlyChanges(['caption', 'car']) && extrasOk(request.resource.data))
        || (isAdmin() && onlyChanges(['hidden']));

      allow delete: if signedIn() && (resource.data.userId == uid() || isAdmin());
    }

    // ------------------------------------------------------------ follows

    match /follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.followerId == uid()
        && request.resource.data.followeeId != uid()
        && id == uid() + '_' + request.resource.data.followeeId;
      allow delete: if signedIn() && resource.data.followerId == uid();
    }

    // ------------------------------------------------------------ Mapbox usage cap

    // One document per billing period. Each write bumps exactly one counter by
    // one and never past its cap: 45,000 map loads, 90,000 Directions requests,
    // 45,000 static card maps.
    match /usage/{period} {
      allow read: if signedIn();
      function n(data, key) {
        return data.get(key, 0);
      }
      function bumped(key, cap) {
        let others = ['mapLoads', 'directions', 'staticMaps'].removeAll([key]);
        return n(request.resource.data, key) == n(resource.data, key) + 1
          && n(request.resource.data, key) <= cap
          && n(request.resource.data, others[0]) == n(resource.data, others[0])
          && n(request.resource.data, others[1]) == n(resource.data, others[1]);
      }
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['mapLoads', 'directions', 'staticMaps'])
        && n(request.resource.data, 'mapLoads') in [0, 1]
        && n(request.resource.data, 'directions') in [0, 1]
        && n(request.resource.data, 'staticMaps') in [0, 1]
        && n(request.resource.data, 'mapLoads') + n(request.resource.data, 'directions') + n(request.resource.data, 'staticMaps') == 1;
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['mapLoads', 'directions', 'staticMaps'])
        && (bumped('mapLoads', 45000) || bumped('directions', 90000) || bumped('staticMaps', 45000));
    }
  }
}
